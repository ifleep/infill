# Copy this file to .env (local dev) and set real values before deploying.

# Real MySQL/MariaDB connection string — both the Prisma CLI (migrate/seed)
# and the running app read this. Get these values from Hostinger's
# hPanel > Databases > MySQL Databases when deploying (see README).
DATABASE_URL="mysql://user:password@127.0.0.1:3306/infillpk"

# Admin login for /admin — set a strong, unique password before deploying.
ADMIN_PASSWORD="change-me-before-deploy"

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-before-deploy"
