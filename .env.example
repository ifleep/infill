# Copy this file to .env (local dev) and set real values before deploying.

# Real MySQL/MariaDB connection string — both the Prisma CLI (migrate/seed)
# and the running app read this. Get these values from Hostinger's
# hPanel > Databases > MySQL Databases when deploying (see README).
DATABASE_URL="mysql://user:password@127.0.0.1:3306/infillpk"

# Admin login for /admin — set a strong, unique password before deploying.
ADMIN_PASSWORD="change-me-before-deploy"

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also signs customer account sessions (register/login) — required for
# checkout and /account to work, not just /admin.
ADMIN_SESSION_SECRET="change-me-before-deploy"

# Optional — order confirmation emails, quote-request and contact-form
# notifications. Without these set, the site works fully (orders, accounts,
# reviews, quote requests all still save to the database) — you just won't
# get emailed about them. Get an API key at https://resend.com, and verify
# a sending domain there before setting RESEND_FROM_EMAIL.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="orders@yourdomain.com"

# Optional — Google Analytics 4 measurement ID (G-XXXXXXX) and Google
# Search Console's HTML-tag verification code. Leave unset to skip both.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# GOOGLE_SITE_VERIFICATION="..."
